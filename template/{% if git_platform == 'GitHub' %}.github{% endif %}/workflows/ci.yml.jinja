name: CI

on:
  push:
    branches: [main]
{%- if publish_to_pypi %}
    tags: ["v*"]
{%- endif %}
  pull_request:
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: {% raw %}${{ github.workflow }}-${{ github.ref }}{% endraw %}
  cancel-in-progress: true

jobs:
  hooks:
    name: Hooks
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v7
        with:
          fetch-depth: 0
      - name: Check committed lock, hook config & secrets baseline
        run: |
          for f in uv.lock prek.toml .secrets.baseline; do
            if [ ! -f "$f" ]; then
              echo "::error::$f is missing - run setup locally & commit it"
              missing=1
            fi
          done
          exit "${missing:-0}"
      - uses: astral-sh/setup-uv@v7
        with:
          enable-cache: true
      - run: uv sync --locked
      - run: uv run prek run --all-files --show-diff-on-failure

  test:
    name: Test (Python {% raw %}${{ matrix.python-version }}{% endraw %})
    runs-on: ubuntu-latest
    strategy:
      fail-fast: false
      matrix:
        python-version: [
          {%- for minor in range(python_min.split('.')[1] | int, (python_max.split('.')[1] | int) + 1) -%}
          "3.{{ minor }}"{% if not loop.last %}, {% endif %}
          {%- endfor -%}
        ]
    steps:
      - uses: actions/checkout@v7
        with:
          fetch-depth: 0
      - uses: astral-sh/setup-uv@v7
        with:
          enable-cache: true
          python-version: {% raw %}${{ matrix.python-version }}{% endraw %}
      - run: uv sync --locked
      - run: uv run coverage run -m pytest
      - run: uv run coverage report --show-missing --skip-covered --fail-under=75

  build:
    name: Build
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v7
        with:
          fetch-depth: 0
      - uses: astral-sh/setup-uv@v7
      - run: uv build --no-sources
      - uses: actions/upload-artifact@v7
        with:
          name: dist
          path: dist/
{%- if publish_to_pypi %}

  publish:
    name: Publish to PyPI
    needs: [hooks, test, build]
    if: startsWith(github.ref, 'refs/tags/v')
    runs-on: ubuntu-latest
    environment:
      name: pypi
      url: https://pypi.org/project/{{ package_name }}/
    permissions:
      id-token: write
    steps:
      - uses: actions/download-artifact@v8
        with:
          name: dist
          path: dist/
      - uses: astral-sh/setup-uv@v7
      - run: uv publish --trusted-publishing always
{%- endif %}

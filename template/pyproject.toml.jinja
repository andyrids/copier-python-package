[project]
name = "{{ package_name }}"
dynamic = ["version"]
description = "{{ package_description }}"
readme = "README.md"
license = "Apache-2.0"
license-files = ["LICEN[CS]E*", "COPYRIGHT"]
authors = [{ name = "{{ user_name }}", email = "{{ user_email }}" }]
maintainers = [{ name = "{{ user_name }}", email = "{{ user_email }}" }]
requires-python = ">={{ python_min }}"
keywords = []
classifiers = [
    # 3 - Alpha | 4 - Beta | 5 - Production/Stable
    "Development Status :: 4 - Beta",
    "Intended Audience :: Developers",
    "License :: OSI Approved :: Apache Software License",
    "Programming Language :: Python :: 3 :: Only",
    {%- for minor in range(python_min.split('.')[1] | int, (python_max.split('.')[1] | int) + 1) %}
    "Programming Language :: Python :: 3.{{ minor }}",
    {%- endfor %}
    "Typing :: Typed",
]
dependencies = ["rich"]

[dependency-groups]
dev = [
    "pkgdx~=0.5",
    "coverage",
    "pytest",
    "pymarkdownlnt",
    {%- if task_runner == 'Just' and install_just_dependency %}
    "rust-just",
    {%- endif %}
]

[project.urls]
Changelog = "{{ git_repository }}/blob/main/CHANGELOG.md"
Documentation = "{{ git_repository }}/blob/main/README.md"
Issues = "{{ git_repository }}/issues"
Repository = "{{ git_repository }}"

[build-system]
requires = ["hatchling", "hatch-vcs"]
build-backend = "hatchling.build"

[tool.coverage.run]
omit = ["tests/*", "*/src_test*/*"]

[tool.hatch.build.targets.sdist]
include = ["/src", "/README.md", "/CHANGELOG.md"]

[tool.hatch.build.targets.wheel]
packages = ["src/{{ import_package_name }}"]

[tool.hatch.version]
source = "vcs"

[tool.hatch.version.raw-options]
# lets SETUPTOOLS_SCM_PRETEND_VERSION_FOR_PKGDX work under hatch-vcs
dist_name = "{{ import_package_name }}"
local_scheme = "no-local-version"
version_scheme = "guess-next-dev"

[tool.pytest.ini_options]
addopts = ["--import-mode=importlib"]
log_cli = true
log_cli_level = "INFO"
testpaths = ["tests"]
tmp_path_retention_policy = "failed"

[tool.uv]
cache-keys = [{ file = "pyproject.toml" }, { git = { commit = true, tags = true } }]

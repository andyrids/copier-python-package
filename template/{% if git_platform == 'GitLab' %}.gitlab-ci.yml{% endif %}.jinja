default:
  image: ghcr.io/astral-sh/uv:0.13-trixie

variables:
  # hatch-vcs derives the version from the full history & tags
  GIT_DEPTH: "0"
  UV_CACHE_DIR: .uv-cache
  UV_LINK_MODE: copy

stages:
  - check
  - test
  - build
{%- if publish_to_pypi %}
  - publish
{%- endif %}

.uv:
  cache:
    key:
      files: [uv.lock]
    paths: [.uv-cache]
  before_script:
    - git fetch --tags --force --quiet
  after_script:
    - uv cache prune --ci

hooks:
  extends: .uv
  stage: check
  script:
    - |
      for f in uv.lock prek.toml .secrets.baseline; do
        if [ ! -f "$f" ]; then
          echo "$f is missing - run setup locally & commit it"
          missing=1
        fi
      done
      exit "${missing:-0}"
    - uv sync --locked
    - uv run prek run --all-files --show-diff-on-failure

test:
  extends: .uv
  stage: test
  parallel:
    matrix:
      - UV_PYTHON: [
          {%- for minor in range(python_min.split('.')[1] | int, (python_max.split('.')[1] | int) + 1) -%}
          "3.{{ minor }}"{% if not loop.last %}, {% endif %}
          {%- endfor -%}
        ]
  script:
    - uv sync --locked
    - uv run coverage run -m pytest
    - uv run coverage report --show-missing --skip-covered --fail-under=75

build:
  extends: .uv
  stage: build
  script:
    - uv build --no-sources
  artifacts:
    paths: [dist/]
{%- if publish_to_pypi %}

publish:
  extends: .uv
  stage: publish
  rules:
    - if: $CI_COMMIT_TAG =~ /^v\d/
  environment:
    name: pypi
    url: https://pypi.org/project/{{ package_name }}/
  id_tokens:
    PYPI_ID_TOKEN:
      aud: pypi
  script:
    - uv publish --trusted-publishing always
{%- endif %}

{#- validators.jinja - `copier.yaml` validator macros -#}

{% macro check_package_name(value) -%}
{% if not (value | regex_search('^([A-Z0-9]|[A-Z0-9][A-Z0-9._-]*[A-Z0-9])$', ignorecase=True)) %}
    Name must start and end with a letter or number, and only contain letters, numbers, '.', '-', or '_'.
{% endif %}
{%- endmacro %}

{% macro check_python_version(value) -%}
{% if not (value | regex_search('^\d+(\.\d+)*$')) %}
    Version must be in the format 'X.Y' or 'X.Y.Z' where X, Y, and Z are numbers.
{% endif %}
{%- endmacro %}

{% macro check_requires_python(value) -%}
{% set specifier = '(~=|==|!=|<=|>=|<|>)\s*\d+(\.\d+)*(\.\*)?' %}
{% if not (value | regex_search('^' ~ specifier ~ '(\s*,\s*' ~ specifier ~ ')*$')) %}
    Must be a valid PEP 440 version specifier e.g. '>=3.9' or '>=3.7, !=3.7.0, !=3.7.1'.
{% endif %}
{%- endmacro %}